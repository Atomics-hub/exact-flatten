{
  "name": "exact-flatten",
  "version": "0.1.1",
  "type": "module",
  "description": "Flatten an object to path/value pairs and get exactly the same object back — keys containing dots, brackets and digits included. Zero dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Tom Ryan",
  "keywords": [
    "flatten",
    "unflatten",
    "nested",
    "object",
    "paths",
    "dot-notation",
    "roundtrip",
    "i18n",
    "zero-dependency"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/api.test.mjs test/differential.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:pack": "node scripts/test-pack.mjs",
    "verify": "npm run build && npm test && npm run test:types && npm run test:pack",
    "bench": "node bench/bench.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "flat": "^6.0.1",
    "flattie": "^1.1.1",
    "safe-flat": "^2.0.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atomics-hub/exact-flatten.git"
  },
  "homepage": "https://github.com/Atomics-hub/exact-flatten#readme",
  "bugs": {
    "url": "https://github.com/Atomics-hub/exact-flatten/issues"
  }
}
